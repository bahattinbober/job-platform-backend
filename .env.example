DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_platform
JWT_SECRET=change-this-to-a-long-random-string
OPENROUTER_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback
# REDIS_URL tanımlıysa REDIS_HOST/REDIS_PORT/REDIS_PASSWORD yerine öncelikli olarak kullanılır.
# Şema rediss:// ise TLS otomatik etkinleşir. Opsiyoneldir.
# REDIS_URL=rediss://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL tanımlı değilse ve Redis'e kimlik doğrulaması gerekiyorsa kullanılır. Opsiyoneldir.
REDIS_PASSWORD=
CORS_ORIGIN=http://localhost:3000
